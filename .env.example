# =============================================================================
# Open Lanka Payment — Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# JWT Secret — MUST change in production (min 32 chars)
JWT_SECRET=dev-jwt-secret-change-in-production-min32chars

# PostgreSQL password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD=olp_dev_password

# Database URLs (one per service)
# NOTE: host ports use the 70xx scheme (see docker-compose). Postgres is published on 7020.
MERCHANT_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/merchant_db?sslmode=disable
PAYMENT_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/payment_db?sslmode=disable
SETTLEMENT_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/settlement_db?sslmode=disable
EXCHANGE_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/exchange_db?sslmode=disable
WEBHOOK_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/webhook_db?sslmode=disable
SUBSCRIPTION_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/subscription_db?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/notification_db?sslmode=disable
ADMIN_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/admin_db?sslmode=disable
DIRECTDEBIT_DATABASE_URL=postgres://olp:olp_dev_password@localhost:7020/directdebit_db?sslmode=disable

# Service Ports (host-published; containers still listen on 808x internally)
GATEWAY_PORT=7000
PAYMENT_PORT=7001
MERCHANT_PORT=7002
SETTLEMENT_PORT=7003
WEBHOOK_PORT=7004
EXCHANGE_PORT=7005
SUBSCRIPTION_PORT=7006
NOTIFICATION_PORT=7007
ADMIN_PORT=7008
DIRECTDEBIT_PORT=7009

# Service URLs (for gateway proxy and inter-service communication — native/host workflow)
MERCHANT_SERVICE_URL=http://localhost:7002
PAYMENT_SERVICE_URL=http://localhost:7001
EXCHANGE_SERVICE_URL=http://localhost:7005
SETTLEMENT_SERVICE_URL=http://localhost:7003
WEBHOOK_SERVICE_URL=http://localhost:7004
SUBSCRIPTION_SERVICE_URL=http://localhost:7006
NOTIFICATION_SERVICE_URL=http://localhost:7007
ADMIN_SERVICE_URL=http://localhost:7008
DIRECTDEBIT_SERVICE_URL=http://localhost:7009

# MinIO / S3 Storage
# Note: Go services read MINIO_* env vars. docker-compose.prod.yml maps S3_* → MINIO_*.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# SMTP — Mailpit for dev, Resend for production
# Dev (Mailpit):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openlankapay.dev
# Production (Resend on DigitalOcean — port 2587 required, 587 is blocked):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=2587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxx  # your Resend API key
# SMTP_FROM=noreply@nipuntheekshana.com

# NATS
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
VITE_API_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
